# Local Python virtual environment (created for local CPU testing).
.venv/

# Generated artifacts — all regenerated by train.py on first run.
tokenizer.json      # the trained BPE tokenizer
data/               # pre-tokenized train.bin / val.bin
checkpoints/        # training checkpoints
*.bin
*.pt                # model checkpoints (multi-GB) — never commit these; they go to the HF Hub

# Python caches
__pycache__/
*.pyc
